{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "researcher": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "job_title": { "type": "string" },
        "affiliation": { "type": "string" },
        "email": { "type": "string" },
        "biography": { "type": "string" },
        "teams": {
          "type": "array",
          "items": { "type": "string" }
        },
        "research_domains": {
          "type": "array",
          "items": { "type": "string" }
        },
        "url": { "type": "string", "format": "uri" }
      },
      "required": ["name", "slug"]
    }
  }
}
