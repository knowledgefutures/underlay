{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "publication": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "authors": { "type": "string" },
        "venue": { "type": "string" },
        "date": { "type": "string" },
        "type": { "type": "string" },
        "url": { "type": "string" },
        "source_url": { "type": "string", "format": "uri" },
        "pdf": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "$file": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
              },
              "required": ["$file"]
            },
            { "type": "null" }
          ]
        },
        "pdf_size": { "type": "integer" }
      },
      "required": ["title", "slug"]
    },
    "case_study": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "subtitle": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "sections": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "images": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        },
        "html": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "$file": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
              },
              "required": ["$file"]
            },
            { "type": "null" }
          ]
        },
        "html_size": { "type": "integer" }
      },
      "required": ["title", "slug"]
    }
  }
}
