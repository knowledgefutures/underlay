{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "segment": {
      "type": "object",
      "title": "TV News Segment",
      "description": "A segment (clip) from a US national evening news broadcast, from the Vanderbilt Television News Archive.",
      "properties": {
        "segment_id": {
          "type": "integer",
          "description": "Vanderbilt archive segment/broadcast ID"
        },
        "title": {
          "type": "string",
          "description": "Segment headline or topic title"
        },
        "network": {
          "type": "string",
          "description": "Broadcasting network (ABC, CBS, NBC, CNN, Fox News)"
        },
        "date": {
          "type": "string",
          "description": "Air date (YYYY-MM-DD)"
        },
        "abstract": {
          "type": "string",
          "description": "Detailed abstract describing the segment content"
        },
        "reporters": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Reporters featured in the segment"
        },
        "duration": {
          "type": "string",
          "description": "Duration in HH:MM:SS format"
        },
        "program_id": {
          "type": ["integer", "null"],
          "description": "Parent broadcast/program ID"
        },
        "program_title": {
          "type": "string",
          "description": "Name of the broadcast program (e.g. 'CBS Evening News')"
        },
        "timestamp_start": {
          "type": "string",
          "description": "Start time within the broadcast"
        },
        "timestamp_end": {
          "type": "string",
          "description": "End time within the broadcast"
        }
      },
      "required": ["segment_id", "title", "network", "date"]
    }
  }
}
