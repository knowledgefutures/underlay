{
  "name": "underlay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash dev.sh",
    "dev:server": "astro dev --host 0.0.0.0 & tsx --watch src/api/server.ts & wait",
    "dev:api": "tsx --watch src/api/server.ts",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:backfill-schemas": "tsx src/db/backfill-schemas.ts",
    "tool:backup": "tsx tools/backupDb.ts",
    "tool:restore": "tsx tools/restore.ts",
    "tool:pruneBackups": "tsx tools/pruneBackups.ts",
    "secrets:encrypt": "sops -e --input-type dotenv --output-type dotenv --output .env.enc .env",
    "secrets:encrypt:dev": "sops -e --input-type dotenv --output-type dotenv --output .env.dev.enc .env.dev",
    "secrets:decrypt": "sops -d --input-type dotenv --output-type dotenv --output .env .env.enc",
    "secrets:decrypt:dev": "sops -d --input-type dotenv --output-type dotenv --output .env.dev .env.dev.enc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/node": "^10.0.0",
    "@astrojs/react": "^5.0.0",
    "@aws-sdk/client-s3": "^3.750.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^10.0.0",
    "@lucide/astro": "^1.11.0",
    "@sinclair/typebox": "^0.34.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0",
    "astro": "^6.0.0",
    "bcrypt": "^6.0.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.2.0",
    "lucide-react": "^1.11.0",
    "marked": "^18.0.0",
    "node-cron": "^4.0.0",
    "postgres": "^3.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tar-stream": "^3.1.8",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^25.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/tar-stream": "^3.1.4",
    "drizzle-kit": "^0.31.0",
    "eslint": "^10.0.0",
    "prettier": "^3.5.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.0"
  },
  "overrides": {
    "@astrojs/react": {
      "@vitejs/plugin-react": "^4.7.0"
    }
  }
}
