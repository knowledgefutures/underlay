{
  "name": "underlay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint .",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "pnpm --filter \"./packages/*\" typecheck",
    "test": "pnpm --filter \"./packages/*\" --workspace-concurrency=1 test"
  },
  "devDependencies": {
    "lint-staged": "^17.0.4",
    "oxfmt": "latest",
    "oxlint": "latest",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.19.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,css,json}": "oxfmt --"
  },
  "packageManager": "pnpm@10.33.3"
}
