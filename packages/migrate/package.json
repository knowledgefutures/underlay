{
  "name": "@underlay/migrate",
  "version": "0.0.0",
  "private": true,
  "description": "Convert an Underlay v1 (Postgres) instance into v2: accounts and settings into SQLite, every collection's version history through the v2 commit engine into a repository.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@underlay/core": "workspace:*",
    "@underlay/repo": "workspace:*",
    "@underlay/server": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^25.0.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.6"
  }
}
