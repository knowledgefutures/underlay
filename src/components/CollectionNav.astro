---
interface Props {
  owner: string;
  collection: string;
  isPublic?: boolean;
  isOwner?: boolean;
  active: "overview" | "versions" | "settings";
  versionLabel?: string; // e.g. "6.0.0" — shown as an extra tab between Versions and Settings
}

const { owner, collection, isPublic, isOwner = false, active, versionLabel } = Astro.props;

const linkClass = "px-3 py-2 text-sm font-medium border-b-2 -mb-px transition-colors";
const activeClass = `${linkClass} border-ink text-ink`;
const inactiveClass = `${linkClass} border-transparent text-ink-muted hover:text-ink hover:border-rule`;
---

<!-- Collection header -->
<div class="flex items-center justify-between mb-2">
  <nav class="flex items-center gap-1.5 text-lg">
    <a href={`/${owner}`} class="text-link hover:underline">{owner}</a>
    <span class="text-ink-muted">/</span>
    <a href={`/${owner}/${collection}`} class="font-semibold hover:underline">{collection}</a>
    {isPublic !== undefined && (
      <span class="border border-rule text-xs text-ink-muted px-1.5 py-0.5 ml-2">{isPublic ? "public" : "private"}</span>
    )}
  </nav>
</div>

<!-- Collection nav -->
<div class="flex items-center gap-0 border-b border-rule mb-6">
  <a href={`/${owner}/${collection}`} class={active === "overview" ? activeClass : inactiveClass}>Overview</a>
  <a href={`/${owner}/${collection}/versions`} class={active === "versions" && !versionLabel ? activeClass : inactiveClass}>Versions</a>
  {versionLabel && (
    <span class={activeClass}>{versionLabel}</span>
  )}
  {isOwner && (
    <a href={`/${owner}/${collection}/settings`} class={`${active === "settings" ? activeClass : inactiveClass} ml-auto`}>Settings</a>
  )}
</div>
