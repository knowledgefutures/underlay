---
import Base from "@/layouts/Base.astro";

const { owner, corpus } = Astro.params;
const apiBase = import.meta.env.DEV ? "http://localhost:3000" : `http://localhost:${import.meta.env.API_PORT ?? 3000}`;
const sessionCookie = Astro.cookies.get("session")?.value;

function formatBytes(bytes: number): string {
  if (!bytes) return "0 B";
  const k = 1024;
  const sizes = ["B", "KB", "MB", "GB", "TB"];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + " " + sizes[i];
}

// Fetch corpus
const corpusRes = await fetch(`${apiBase}/api/corpora/${owner}/${corpus}`);
if (!corpusRes.ok) {
  return Astro.redirect("/404");
}
const data = await corpusRes.json();

// Fetch versions
const versionsRes = await fetch(`${apiBase}/api/corpora/${owner}/${corpus}/versions?limit=20`);
const versions = versionsRes.ok ? await versionsRes.json() : [];

// Check if current user is the owner (for settings link)
let isOwner = false;
if (sessionCookie) {
  try {
    const meRes = await fetch(`${apiBase}/api/accounts/me`, {
      headers: { Cookie: `session=${sessionCookie}` },
    });
    if (meRes.ok) {
      const me = await meRes.json();
      isOwner = me.slug === owner;
    }
  } catch {}
}
---

<Base title={`${data.name} — Underlay`} description={data.description}>
  <div class="max-w-3xl mx-auto px-4 py-10">
    <nav class="text-xs text-ink-muted mb-4">
      <a href={`/${owner}`} class="hover:text-ink">{owner}</a>
      <span class="mx-1">/</span>
      <span class="text-ink font-medium">{data.slug}</span>
    </nav>

    <div class="mb-6">
      <h1 class="text-xl font-semibold tracking-tight mb-1">{data.name}</h1>
      {data.description && <p class="text-sm text-ink-muted">{data.description}</p>}
      <div class="flex items-center gap-3 mt-2 text-xs text-ink-muted">
        {data.public && <span class="border border-rule px-1.5 py-0.5">public</span>}
        <span>by <a href={`/${data.ownerSlug}`} class="text-link underline">{data.ownerName}</a></span>
        {isOwner && <a href={`/${owner}/${corpus}/settings`} class="text-link underline">Settings</a>}
      </div>
    </div>

    {data.latestVersion && (
      <div class="border border-rule p-4 mb-6 bg-parchment-dark">
        <div class="flex items-center justify-between mb-2">
          <span class="text-sm font-semibold">Latest: {data.latestVersion.semver} (#{data.latestVersion.number})</span>
          <a href={`/${owner}/${corpus}/v/${data.latestVersion.number}`} class="text-xs text-link underline">View →</a>
        </div>
        <div class="grid grid-cols-3 gap-4 text-xs text-ink-muted">
          <div>
            <span class="block text-ink font-medium">{data.latestVersion.recordCount.toLocaleString()}</span>
            records
          </div>
          <div>
            <span class="block text-ink font-medium">{data.latestVersion.fileCount.toLocaleString()}</span>
            files
          </div>
          <div>
            <span class="block text-ink font-medium">{formatBytes(data.latestVersion.totalBytes)}</span>
            total
          </div>
        </div>
        {data.latestVersion.message && (
          <p class="text-xs text-ink-muted mt-2 italic">"{data.latestVersion.message}"</p>
        )}
      </div>
    )}

    <h2 class="text-sm font-semibold uppercase tracking-wide text-ink-muted mb-3">
      Version History ({versions.length})
    </h2>

    {versions.length === 0 ? (
      <p class="text-sm text-ink-muted">No versions yet.</p>
    ) : (
      <div class="space-y-1">
        {versions.map((v: any) => (
          <a href={`/${owner}/${corpus}/v/${v.number}`} class="flex items-center justify-between border border-rule p-3 hover:bg-parchment-dark transition-colors text-sm">
            <div class="flex items-center gap-3">
              <span class="font-mono text-xs text-ink-muted">#{v.number}</span>
              <span class="font-medium">{v.semver}</span>
              {v.message && <span class="text-xs text-ink-muted truncate max-w-[20rem]">{v.message}</span>}
            </div>
            <div class="flex items-center gap-4 text-xs text-ink-muted">
              <span>{v.recordCount} records</span>
              <span>{new Date(v.createdAt).toLocaleDateString()}</span>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</Base>
