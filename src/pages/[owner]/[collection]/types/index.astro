---
import Base from "@/layouts/Base.astro";
import CollectionNav from "@/components/CollectionNav.astro";
import { apiBase, checkOwnership } from "@/lib/page-utils";

const { owner, collection } = Astro.params;
const sessionCookie = Astro.cookies.get("session")?.value;

const collectionRes = await fetch(`${apiBase}/api/collections/${owner}/${collection}`);
if (!collectionRes.ok) return Astro.redirect("/404");
const collectionData = await collectionRes.json();

const typesRes = await fetch(`${apiBase}/api/collections/${owner}/${collection}/types`);
const types = typesRes.ok ? await typesRes.json() : [];

const isOwner = await checkOwnership(sessionCookie, owner!);
---

<Base title={`Types — ${owner}/${collection} — Underlay`}>
  <div class="max-w-5xl mx-auto px-4 py-8">
    <CollectionNav owner={owner!} collection={collection!} isPublic={collectionData.public} isOwner={isOwner} active="overview" />

    <h2 class="text-lg font-semibold mb-4">Record types</h2>
    <p class="text-sm text-ink-muted mb-6">
      Record types are the schemas that records in this collection conform to. Each type can be referenced by other collections via <code class="font-mono text-xs">$ref</code>.
    </p>

    {types.length === 0 ? (
      <p class="text-sm text-ink-muted">No record types defined yet.</p>
    ) : (
      <div class="border border-rule rounded overflow-hidden">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-parchment-dark border-b border-rule">
              <th class="text-left p-3 font-medium">Type</th>
              <th class="text-left p-3 font-medium">First version</th>
              <th class="text-left p-3 font-medium">Latest version</th>
              <th class="text-right p-3 font-medium">Used in versions</th>
            </tr>
          </thead>
          <tbody>
            {types.map((t: any) => (
              <tr class="border-t border-rule hover:bg-parchment-dark/50">
                <td class="p-3">
                  <a href={`/${owner}/${collection}/types/${t.slug}`} class="text-link hover:underline font-mono">{t.slug}</a>
                  {t.description && <p class="text-xs text-ink-muted mt-0.5">{t.description}</p>}
                </td>
                <td class="p-3">v{t.firstAppearedInVersion ?? "—"}</td>
                <td class="p-3">v{t.latestVersion ?? "—"}</td>
                <td class="p-3 text-right">{t.versionsUsing}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</Base>
