---
import Base from "@/layouts/Base.astro";
import CollectionNav from "@/components/CollectionNav.astro";
import SchemaEditor from "@/components/SchemaEditor.tsx";
import { apiBase, checkOwnership } from "@/lib/page-utils";

const { owner, collection } = Astro.params;
const sessionCookie = Astro.cookies.get("session")?.value;

const isOwner = await checkOwnership(sessionCookie, owner!);
if (!isOwner) return Astro.redirect(`/${owner}/${collection}/schemas`);

const collectionRes = await fetch(`${apiBase}/api/collections/${owner}/${collection}`);
if (!collectionRes.ok) return Astro.redirect("/404");
const collectionData = await collectionRes.json();
---

<Base title={`Edit Schemas — ${owner}/${collection} — Underlay`}>
  <div class="max-w-5xl mx-auto px-4 py-8">
    <CollectionNav owner={owner!} collection={collection!} isPublic={collectionData.public} isOwner={isOwner} active="schemas" />

    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-base font-semibold">Schema Editor</h2>
        <p class="text-xs text-ink-muted mt-0.5">
          Edit per-type schemas. Publishing creates a new major version if schemas differ from the current version.
          Schemas inferred from your first record of each type are shown as a starting point.
        </p>
      </div>
      <a href={`/${owner}/${collection}/schemas`} class="text-xs text-ink-muted hover:text-ink transition-colors">← Back to schemas</a>
    </div>

    <SchemaEditor owner={owner!} collection={collection!} client:load />
  </div>
</Base>
