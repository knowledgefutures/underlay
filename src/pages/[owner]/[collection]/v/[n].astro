---
import Base from "@/layouts/Base.astro";

const { owner, collection, n } = Astro.params;
const apiBase = import.meta.env.DEV ? "http://localhost:3000" : `http://localhost:${import.meta.env.API_PORT ?? 3000}`;

function formatBytes(bytes: number): string {
  if (!bytes) return "0 B";
  const k = 1024;
  const sizes = ["B", "KB", "MB", "GB", "TB"];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + " " + sizes[i];
}

// Fetch version
const versionRes = await fetch(`${apiBase}/api/collections/${owner}/${collection}/versions/${n}`);
if (!versionRes.ok) {
  return Astro.redirect("/404");
}
const version = await versionRes.json();

// Fetch records (first page)
const page = parseInt(Astro.url.searchParams.get("page") ?? "1", 10);
const pageSize = 100;
const offset = (page - 1) * pageSize;
const recordsRes = await fetch(`${apiBase}/api/collections/${owner}/${collection}/versions/${n}/records?limit=${pageSize}&offset=${offset}`);
const records = recordsRes.ok ? await recordsRes.json() : [];
const totalRecords = version.recordCount ?? 0;
const totalPages = Math.ceil(totalRecords / pageSize);

// Pre-compute visible page numbers for pagination
const pageNumbers: number[] = [];
if (totalPages > 1) {
  const maxVisible = Math.min(totalPages, 7);
  for (let i = 0; i < maxVisible; i++) {
    let p: number;
    if (totalPages <= 7) {
      p = i + 1;
    } else if (page <= 4) {
      p = i + 1;
    } else if (page >= totalPages - 3) {
      p = totalPages - 6 + i;
    } else {
      p = page - 3 + i;
    }
    pageNumbers.push(p);
  }
}

// Group records by type
const byType: Record<string, any[]> = {};
for (const r of records) {
  if (!byType[r.type]) byType[r.type] = [];
  byType[r.type].push(r);
}
const types = Object.keys(byType).sort();

// Parse schema to get field names per type
const schemaDoc = version.schema as Record<string, any>;
const schemaProperties = schemaDoc?.properties ?? {};
---

<Base title={`${version.semver} — ${owner}/${collection} — Underlay`}>
  <div class="max-w-5xl mx-auto px-4 py-10">
    <nav class="text-xs text-ink-muted mb-4">
      <a href={`/${owner}`} class="hover:text-ink">{owner}</a>
      <span class="mx-1">/</span>
      <a href={`/${owner}/${collection}`} class="hover:text-ink">{collection}</a>
      <span class="mx-1">/</span>
      <span class="text-ink font-medium">{version.semver}</span>
    </nav>

    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-xl font-semibold tracking-tight">
          Version {version.number} <span class="text-ink-muted font-normal">({version.semver})</span>
        </h1>
        {version.message && <p class="text-sm text-ink-muted mt-1">{version.message}</p>}
      </div>
      <div class="text-right text-xs text-ink-muted">
        <div>{new Date(version.createdAt).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</div>
        {version.appId && <div>via {version.appId}</div>}
      </div>
    </div>

    <div class="grid grid-cols-4 gap-4 mb-6 text-sm">
      <div class="border border-rule p-3">
        <span class="block text-ink font-medium text-lg">{version.recordCount.toLocaleString()}</span>
        <span class="text-xs text-ink-muted">records</span>
      </div>
      <div class="border border-rule p-3">
        <span class="block text-ink font-medium text-lg">{version.fileCount.toLocaleString()}</span>
        <span class="text-xs text-ink-muted">files</span>
      </div>
      <div class="border border-rule p-3">
        <span class="block text-ink font-medium text-lg">{formatBytes(version.totalBytes)}</span>
        <span class="text-xs text-ink-muted">total size</span>
      </div>
      <div class="border border-rule p-3">
        <span class="block text-ink font-medium text-lg">{types.length}</span>
        <span class="text-xs text-ink-muted">record types</span>
      </div>
    </div>

    <div class="border border-rule p-3 mb-6">
      <h2 class="text-xs font-semibold uppercase tracking-wide text-ink-muted mb-2">Hash</h2>
      <code class="text-xs font-mono break-all">{version.hash}</code>
    </div>

    <!-- Schema viewer -->
    <details class="border border-rule mb-6">
      <summary class="p-3 cursor-pointer text-sm font-semibold hover:bg-parchment-dark">
        Schema
      </summary>
      <pre class="p-3 text-xs font-mono overflow-x-auto bg-ink text-parchment"><code set:text={JSON.stringify(version.schema, null, 2)} /></pre>
    </details>

    <!-- Records by type -->
    {types.map((type) => {
      const typeRecords = byType[type];
      const fields = schemaProperties[type]?.properties
        ? Object.keys(schemaProperties[type].properties)
        : typeRecords.length > 0
          ? Object.keys(typeRecords[0].data ?? {})
          : [];

      return (
        <div class="mb-6">
          <h2 class="text-sm font-semibold mb-2">
            {type} <span class="text-ink-muted font-normal">({typeRecords.length}{totalRecords > pageSize ? ` of ${totalRecords.toLocaleString()}` : ""})</span>
          </h2>
          <div class="overflow-x-auto border border-rule">
            <table class="w-full text-xs">
              <thead>
                <tr class="bg-parchment-dark">
                  <th class="text-left p-2 font-medium">id</th>
                  {fields.map((f: string) => (
                    <th class="text-left p-2 font-medium">{f}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {typeRecords.map((r: any) => (
                  <tr class="border-t border-rule hover:bg-parchment-dark">
                    <td class="p-2 font-mono text-ink-muted">{r.id}</td>
                    {fields.map((f: string) => {
                      const val = r.data?.[f];
                      // $file reference — render as download/preview link
                      if (val && typeof val === "object" && "$file" in val) {
                        const hash = (val as any).$file as string;
                        const fileUrl = `/api/collections/${owner}/${collection}/files/${hash}`;
                        const label = f === "pdf" ? "PDF" : "File";
                        return (
                          <td class="p-2">
                            <a href={fileUrl} target="_blank" class="inline-flex items-center gap-1 text-link underline hover:text-ink">
                              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                              {label}
                            </a>
                          </td>
                        );
                      }
                      // URL — render as clickable link
                      if (typeof val === "string" && val.match(/^https?:\/\//)) {
                        return (
                          <td class="p-2 max-w-[16rem] truncate">
                            <a href={val} target="_blank" rel="noopener noreferrer" class="text-link underline hover:text-ink">{val}</a>
                          </td>
                        );
                      }
                      const display = val === null || val === undefined
                        ? ""
                        : typeof val === "object"
                          ? JSON.stringify(val)
                          : String(val);
                      return <td class="p-2 max-w-[16rem] truncate">{display}</td>;
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      );
    })}

    {totalPages > 1 && (
      <nav class="flex items-center justify-between border border-rule p-3 text-xs">
        <span class="text-ink-muted">
          Showing {offset + 1}–{Math.min(offset + pageSize, totalRecords)} of {totalRecords.toLocaleString()} records
        </span>
        <div class="flex items-center gap-2">
          {page > 1 && (
            <a href={`/${owner}/${collection}/v/${n}?page=${page - 1}`} class="border border-rule px-2 py-1 hover:bg-parchment-dark">← Prev</a>
          )}
          {pageNumbers.map((p) => (
            <a
              href={`/${owner}/${collection}/v/${n}?page=${p}`}
              class={p === page ? "border border-ink bg-ink text-parchment font-medium px-2 py-1" : "border border-rule px-2 py-1 hover:bg-parchment-dark"}
            >
              {p}
            </a>
          ))}
          {page < totalPages && (
            <a href={`/${owner}/${collection}/v/${n}?page=${page + 1}`} class="border border-rule px-2 py-1 hover:bg-parchment-dark">Next →</a>
          )}
        </div>
      </nav>
    )}
  </div>
</Base>
