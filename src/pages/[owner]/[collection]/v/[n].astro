---
import Base from "@/layouts/Base.astro";
import CollectionNav from "@/components/CollectionNav.astro";
import { apiBase, formatBytes, checkOwnership } from "@/lib/page-utils";
import { marked } from "marked";

const { owner, collection, n } = Astro.params;
const sessionCookie = Astro.cookies.get("session")?.value;

// Fetch version
const versionRes = await fetch(`${apiBase}/api/collections/${owner}/${collection}/versions/${n}`);
if (!versionRes.ok) {
  return Astro.redirect("/404");
}
const version = await versionRes.json();

// Fetch collection metadata (for public badge, etc.)
const collectionRes = await fetch(`${apiBase}/api/collections/${owner}/${collection}`);
const collectionData = collectionRes.ok ? await collectionRes.json() : null;

// Check if current user is the owner (for settings link)
const isOwner = await checkOwnership(sessionCookie, owner!);

// Render readme if present
const readmeHtml = version.readme ? marked.parse(version.readme) : null;

// Tab state
const tab = Astro.url.searchParams.get("tab") ?? "records";
const selectedType = Astro.url.searchParams.get("type") ?? null;

// Parse schemas to get type info
const versionSchemas = (version.schemas ?? []) as Array<{ slug: string; schema: any; schemaHash: string; sourceSchemaId: string | null }>;
const allTypes = versionSchemas.map((s: any) => s.slug).sort();

// Fetch records only on records tab
let records: any[] = [];
let totalRecords = version.recordCount ?? 0;
let page = 1;
let pageSize = 100;
let offset = 0;
let totalPages = 1;
let pageNumbers: number[] = [];
let byType: Record<string, any[]> = {};
let currentType = selectedType || (allTypes.length > 0 ? allTypes[0] : null);

if (tab === "records" && currentType) {
  page = parseInt(Astro.url.searchParams.get("page") ?? "1", 10);
  pageSize = 100;
  offset = (page - 1) * pageSize;
  const recordsRes = await fetch(`${apiBase}/api/collections/${owner}/${collection}/versions/${n}/records?type=${currentType}&limit=${pageSize}&offset=${offset}`);
  records = recordsRes.ok ? await recordsRes.json() : [];

  // We need the total count for this type — get all records count per type from schema
  // For now, use the records returned and version.recordCount
  const allRecordsRes = await fetch(`${apiBase}/api/collections/${owner}/${collection}/versions/${n}/records?limit=1&offset=0&type=${currentType}`);
  // We'll use the version recordCount as an approximation; for type-specific counts we need to check
  // Actually, let's fetch a count per type from the full page
  totalPages = Math.ceil(records.length < pageSize ? 1 : totalRecords / pageSize);

  pageNumbers = [];
  if (totalPages > 1) {
    const maxVisible = Math.min(totalPages, 7);
    for (let i = 0; i < maxVisible; i++) {
      let p: number;
      if (totalPages <= 7) {
        p = i + 1;
      } else if (page <= 4) {
        p = i + 1;
      } else if (page >= totalPages - 3) {
        p = totalPages - 6 + i;
      } else {
        p = page - 3 + i;
      }
      pageNumbers.push(p);
    }
  }
}

// Fetch files only on files tab
let files: any[] = [];
if (tab === "files") {
  const filesRes = await fetch(`${apiBase}/api/collections/${owner}/${collection}/versions/${n}/files`);
  files = filesRes.ok ? await filesRes.json() : [];
}

// Build tab URL helper
function tabUrl(t: string, extra?: Record<string, string>) {
  const base = `/${owner}/${collection}/v/${n}`;
  const params = new URLSearchParams();
  if (t !== "records") params.set("tab", t);
  if (extra) {
    for (const [k, v] of Object.entries(extra)) params.set(k, v);
  }
  const qs = params.toString();
  return qs ? `${base}?${qs}` : base;
}
---

<Base title={`${version.semver} — ${owner}/${collection} — Underlay`}>
  <div class="max-w-5xl mx-auto px-4 py-8">
    <CollectionNav owner={owner!} collection={collection!} isPublic={collectionData?.public} isOwner={isOwner} active="versions" versionLabel={version.semver} />

    {version.message && <p class="text-sm text-ink-muted mb-4">{version.message}</p>}
    {!version.message && <div class="mb-4" />}

    <!-- Info bar -->
    <div class="flex items-center justify-between text-xs text-ink-muted py-2.5 px-4 border border-rule rounded bg-parchment-dark mb-6">
      <div class="flex items-center gap-4">
        <span><strong class="text-ink">{version.recordCount.toLocaleString()}</strong> records</span>
        <span><strong class="text-ink">{version.fileCount.toLocaleString()}</strong> files</span>
        <span><strong class="text-ink">{formatBytes(version.totalBytes)}</strong> total</span>
        <span><strong class="text-ink">{allTypes.length}</strong> types</span>
      </div>
      <div class="flex items-center gap-4">
        {version.appId && <span>via <strong class="text-ink">{version.appId}</strong></span>}
        <span>{new Date(version.createdAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</span>
        <code class="font-mono text-[11px] text-ink-muted" title={version.hash}>sha256:{version.hash.slice(0, 12)}…</code>
      </div>
    </div>

    <!-- Tabs -->
    <div class="flex items-center gap-0 border-b border-rule mb-6">
      <a
        href={tabUrl("records", currentType ? { type: currentType } : undefined)}
        class={`px-4 py-2.5 text-sm font-medium border-b-2 -mb-px transition-colors ${tab === "records" ? "border-ink text-ink" : "border-transparent text-ink-muted hover:text-ink hover:border-rule"}`}
      >
        Records <span class="text-ink-muted font-normal">({version.recordCount.toLocaleString()})</span>
      </a>
      <a
        href={tabUrl("schema")}
        class={`px-4 py-2.5 text-sm font-medium border-b-2 -mb-px transition-colors ${tab === "schema" ? "border-ink text-ink" : "border-transparent text-ink-muted hover:text-ink hover:border-rule"}`}
      >
        Schema
      </a>
      <a
        href={tabUrl("files")}
        class={`px-4 py-2.5 text-sm font-medium border-b-2 -mb-px transition-colors ${tab === "files" ? "border-ink text-ink" : "border-transparent text-ink-muted hover:text-ink hover:border-rule"}`}
      >
        Files <span class="text-ink-muted font-normal">({version.fileCount.toLocaleString()})</span>
      </a>
      <a
        href={tabUrl("metadata")}
        class={`px-4 py-2.5 text-sm font-medium border-b-2 -mb-px transition-colors ${tab === "metadata" ? "border-ink text-ink" : "border-transparent text-ink-muted hover:text-ink hover:border-rule"}`}
      >
        Metadata
      </a>
    </div>

    <!-- Records tab -->
    {tab === "records" && (
      <div class="grid grid-cols-[180px_1fr] gap-6">
        <!-- Type sidebar -->
        <nav class="space-y-0.5">
          <h3 class="text-xs font-semibold uppercase tracking-wide text-ink-muted mb-2">Types</h3>
          {allTypes.map((t) => (
            <a
              href={`/${owner}/${collection}/v/${n}?type=${t}`}
              class={`block px-3 py-1.5 text-sm rounded transition-colors ${t === currentType ? "bg-ink text-parchment font-medium" : "text-ink-muted hover:bg-parchment-dark hover:text-ink"}`}
            >
              {t}
            </a>
          ))}
        </nav>

        <!-- Table area -->
        <div class="min-w-0">
          {currentType && records.length > 0 && (() => {
            const currentTypeSchema = versionSchemas.find((s: any) => s.slug === currentType)?.schema;
            const fields = currentTypeSchema?.properties
              ? Object.keys(currentTypeSchema.properties)
              : records.length > 0
                ? Object.keys(records[0].data ?? {})
                : [];

            return (
              <div>
                <div class="overflow-x-auto border border-rule rounded">
                  <table class="w-full text-xs">
                    <thead>
                      <tr class="bg-parchment-dark">
                        <th class="text-left p-2 font-medium border-b border-rule">id</th>
                        {fields.map((f: string) => (
                          <th class="text-left p-2 font-medium border-b border-rule">{f}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {records.map((r: any) => (
                        <tr class="border-t border-rule hover:bg-parchment-dark/50">
                          <td class="p-2 font-mono text-ink-muted">{r.id}</td>
                          {fields.map((f: string) => {
                            const val = r.data?.[f];
                            if (val && typeof val === "object" && "$file" in val) {
                              const hash = (val as any).$file as string;
                              const fileUrl = `/api/collections/${owner}/${collection}/files/${hash}`;
                              const label = f === "pdf" ? "PDF" : "File";
                              return (
                                <td class="p-2">
                                  <a href={fileUrl} target="_blank" class="inline-flex items-center gap-1 text-link hover:underline">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                                    {label}
                                  </a>
                                </td>
                              );
                            }
                            if (typeof val === "string" && val.match(/^https?:\/\//)) {
                              return (
                                <td class="p-2 max-w-56 truncate">
                                  <a href={val} target="_blank" rel="noopener noreferrer" class="text-link hover:underline">{val}</a>
                                </td>
                              );
                            }
                            const display = val === null || val === undefined
                              ? ""
                              : typeof val === "object"
                                ? JSON.stringify(val)
                                : String(val);
                            return <td class="p-2 max-w-56 truncate">{display}</td>;
                          })}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>

                {totalPages > 1 && (
                  <nav class="flex items-center justify-between py-3 text-xs">
                    <span class="text-ink-muted">
                      Showing {offset + 1}–{Math.min(offset + pageSize, totalRecords)} of {totalRecords.toLocaleString()}
                    </span>
                    <div class="flex items-center gap-1">
                      {page > 1 && (
                        <a href={`/${owner}/${collection}/v/${n}?type=${currentType}&page=${page - 1}`} class="border border-rule px-2 py-1 rounded hover:bg-parchment-dark">← Prev</a>
                      )}
                      {pageNumbers.map((p) => (
                        <a
                          href={`/${owner}/${collection}/v/${n}?type=${currentType}&page=${p}`}
                          class={p === page ? "border border-ink bg-ink text-parchment font-medium px-2 py-1 rounded" : "border border-rule px-2 py-1 rounded hover:bg-parchment-dark"}
                        >
                          {p}
                        </a>
                      ))}
                      {page < totalPages && (
                        <a href={`/${owner}/${collection}/v/${n}?type=${currentType}&page=${page + 1}`} class="border border-rule px-2 py-1 rounded hover:bg-parchment-dark">Next →</a>
                      )}
                    </div>
                  </nav>
                )}
              </div>
            );
          })()}
          {(!currentType || records.length === 0) && (
            <p class="text-sm text-ink-muted py-8 text-center">Select a type to view records.</p>
          )}
        </div>
      </div>
    )}

    <!-- Schema tab -->
    {tab === "schema" && (
      <div class="space-y-3">
        {versionSchemas.length === 0 ? (
          <p class="text-sm text-ink-muted py-8 text-center">No schemas defined for this version.</p>
        ) : versionSchemas.map((s: any) => (
          <div class="border border-rule rounded overflow-hidden">
            <div class="px-3 py-2 border-b border-rule bg-parchment-dark flex items-center gap-2">
              <span class="font-medium text-sm">{s.slug}</span>
              {s.sourceSchemaId && <span class="text-[11px] border border-rule px-1.5 py-0.5 text-ink-muted">adopted</span>}
            </div>
            <pre class="p-4 text-xs font-mono overflow-x-auto bg-ink text-parchment"><code set:text={JSON.stringify(s.schema, null, 2)} /></pre>
          </div>
        ))}
      </div>
    )}

    <!-- Files tab -->
    {tab === "files" && (
      <div>
        {files.length === 0 ? (
          <p class="text-sm text-ink-muted py-8 text-center">No files in this version.</p>
        ) : (
          <div>
            <p class="text-xs text-ink-muted mb-3">{files.length} file{files.length !== 1 ? "s" : ""} · {formatBytes(files.reduce((sum: number, f: any) => sum + (f.size ?? 0), 0))} total</p>
            <div class="border border-rule rounded overflow-hidden">
              <table class="w-full text-xs">
                <thead>
                  <tr class="bg-parchment-dark border-b border-rule">
                    <th class="text-left p-2.5 font-medium">File</th>
                    <th class="text-left p-2.5 font-medium">Referenced by</th>
                    <th class="text-right p-2.5 font-medium">Size</th>
                    <th class="text-right p-2.5 font-medium"></th>
                  </tr>
                </thead>
                <tbody>
                  {files.map((f: any) => {
                    const refs: any[] = f.references ?? [];
                    const ext = f.mimeType?.split("/")[1] ?? "";
                    const isPdf = f.mimeType === "application/pdf";
                    const isImage = f.mimeType?.startsWith("image/");
                    return (
                      <tr class="border-t border-rule hover:bg-parchment-dark/50">
                        <td class="p-2.5">
                          <div class="flex items-center gap-2">
                            {isPdf ? (
                              <svg class="w-4 h-4 text-red-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
                            ) : isImage ? (
                              <svg class="w-4 h-4 text-blue-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                            ) : (
                              <svg class="w-4 h-4 text-ink-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                            )}
                            <div>
                              <code class="font-mono text-[11px] text-ink-muted">{f.hash.slice(0, 12)}…</code>
                              <span class="ml-2 text-ink-muted">{f.mimeType}</span>
                            </div>
                          </div>
                        </td>
                        <td class="p-2.5">
                          {refs.length > 0 ? (
                            <div class="flex flex-wrap gap-1">
                              {refs.slice(0, 3).map((ref: any) => (
                                <a
                                  href={`/${owner}/${collection}/v/${n}?type=${ref.type}`}
                                  class="inline-flex items-center gap-1 text-[11px] bg-parchment-dark border border-rule px-1.5 py-0.5 rounded hover:border-ink-muted transition-colors"
                                >
                                  <span class="text-ink-muted">{ref.type}</span>
                                  <span class="font-mono">{ref.recordId.length > 20 ? ref.recordId.slice(0, 20) + "…" : ref.recordId}</span>
                                </a>
                              ))}
                              {refs.length > 3 && (
                                <span class="text-[11px] text-ink-muted px-1.5 py-0.5">+{refs.length - 3} more</span>
                              )}
                            </div>
                          ) : (
                            <span class="text-ink-muted">—</span>
                          )}
                        </td>
                        <td class="p-2.5 text-right whitespace-nowrap">{formatBytes(f.size)}</td>
                        <td class="p-2.5 text-right">
                          <a href={`/api/collections/${owner}/${collection}/files/sha256:${f.hash}`} target="_blank" class="text-link hover:underline">
                            <svg class="w-4 h-4 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                          </a>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>
        )}
      </div>
    )}

    <!-- Metadata tab -->
    {tab === "metadata" && (
      <div class="max-w-2xl">
        {/* Collection-level metadata (from latest version / collection record) */}
        <h3 class="text-xs font-semibold uppercase tracking-wide text-ink-muted mb-3">Collection</h3>
        <table class="w-full text-sm mb-8">
          <tbody>
            {collectionData?.name && (
              <tr class="border-b border-rule">
                <td class="py-3 pr-6 text-ink-muted font-medium w-40">Name</td>
                <td class="py-3">{collectionData.name}</td>
              </tr>
            )}
            {collectionData?.description && (
              <tr class="border-b border-rule">
                <td class="py-3 pr-6 text-ink-muted font-medium">Description</td>
                <td class="py-3">{collectionData.description}</td>
              </tr>
            )}
            <tr class="border-b border-rule">
              <td class="py-3 pr-6 text-ink-muted font-medium">Owner</td>
              <td class="py-3"><a href={`/${owner}`} class="text-link hover:underline">{collectionData?.ownerName ?? owner}</a> <span class="text-ink-muted text-xs">({owner})</span></td>
            </tr>
            <tr class="border-b border-rule">
              <td class="py-3 pr-6 text-ink-muted font-medium">Visibility</td>
              <td class="py-3">{collectionData?.public ? "Public" : "Private"}</td>
            </tr>
          </tbody>
        </table>

        {/* Version-level metadata */}
        <h3 class="text-xs font-semibold uppercase tracking-wide text-ink-muted mb-3">Version</h3>
        <table class="w-full text-sm mb-8">
          <tbody>
            <tr class="border-b border-rule">
              <td class="py-3 pr-6 text-ink-muted font-medium w-40">Version</td>
              <td class="py-3">{version.number} ({version.semver})</td>
            </tr>
            <tr class="border-b border-rule">
              <td class="py-3 pr-6 text-ink-muted font-medium">Hash</td>
              <td class="py-3 font-mono text-xs break-all">sha256:{version.hash}</td>
            </tr>
            <tr class="border-b border-rule">
              <td class="py-3 pr-6 text-ink-muted font-medium">Created</td>
              <td class="py-3">{new Date(version.createdAt).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", hour: "2-digit", minute: "2-digit" })}</td>
            </tr>
            {version.baseNumber !== null && version.baseNumber !== undefined && (
              <tr class="border-b border-rule">
                <td class="py-3 pr-6 text-ink-muted font-medium">Base version</td>
                <td class="py-3"><a href={`/${owner}/${collection}/v/${version.baseNumber}`} class="text-link hover:underline">v{version.baseNumber}</a></td>
              </tr>
            )}
            {version.message && (
              <tr class="border-b border-rule">
                <td class="py-3 pr-6 text-ink-muted font-medium">Message</td>
                <td class="py-3">{version.message}</td>
              </tr>
            )}
            <tr class="border-b border-rule">
              <td class="py-3 pr-6 text-ink-muted font-medium">Records</td>
              <td class="py-3">{version.recordCount.toLocaleString()}</td>
            </tr>
            <tr class="border-b border-rule">
              <td class="py-3 pr-6 text-ink-muted font-medium">Files</td>
              <td class="py-3">{version.fileCount.toLocaleString()}</td>
            </tr>
            <tr class="border-b border-rule">
              <td class="py-3 pr-6 text-ink-muted font-medium">Total size</td>
              <td class="py-3">{formatBytes(version.totalBytes)}</td>
            </tr>
            <tr class="border-b border-rule">
              <td class="py-3 pr-6 text-ink-muted font-medium">Types</td>
              <td class="py-3">{allTypes.join(", ") || "—"}</td>
            </tr>
          </tbody>
        </table>

        {/* Provenance */}
        <h3 class="text-xs font-semibold uppercase tracking-wide text-ink-muted mb-3">Provenance</h3>
        <table class="w-full text-sm mb-8">
          <tbody>
            {version.appId && (
              <tr class="border-b border-rule">
                <td class="py-3 pr-6 text-ink-muted font-medium w-40">App ID</td>
                <td class="py-3 font-mono text-xs">{version.appId}</td>
              </tr>
            )}
            {version.actorId && (
              <tr class="border-b border-rule">
                <td class="py-3 pr-6 text-ink-muted font-medium">Actor ID</td>
                <td class="py-3 font-mono text-xs">{version.actorId}</td>
              </tr>
            )}
            {version.pushedBy && (
              <tr class="border-b border-rule">
                <td class="py-3 pr-6 text-ink-muted font-medium">Pushed by</td>
                <td class="py-3 font-mono text-xs">{version.pushedBy}</td>
              </tr>
            )}
            {version.signature && (
              <tr class="border-b border-rule">
                <td class="py-3 pr-6 text-ink-muted font-medium">Signature</td>
                <td class="py-3 font-mono text-xs break-all">{version.signature}</td>
              </tr>
            )}
          </tbody>
        </table>

        {/* README */}
        {version.readme && (
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wide text-ink-muted mb-3">README</h3>
            <div class="border border-rule rounded p-5 prose prose-sm max-w-none" set:html={readmeHtml} />
          </div>
        )}
      </div>
    )}
  </div>
</Base>
