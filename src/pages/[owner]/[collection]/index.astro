---
import Base from "@/layouts/Base.astro";

const { owner, collection } = Astro.params;
const apiBase = import.meta.env.DEV ? "http://localhost:3000" : `http://localhost:${import.meta.env.API_PORT ?? 3000}`;
const sessionCookie = Astro.cookies.get("session")?.value;

function formatBytes(bytes: number): string {
  if (!bytes) return "0 B";
  const k = 1024;
  const sizes = ["B", "KB", "MB", "GB", "TB"];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + " " + sizes[i];
}

// Fetch collection
const collectionRes = await fetch(`${apiBase}/api/collections/${owner}/${collection}`);
if (!collectionRes.ok) {
  return Astro.redirect("/404");
}
const data = await collectionRes.json();

// Fetch versions
const versionsRes = await fetch(`${apiBase}/api/collections/${owner}/${collection}/versions?limit=20`);
const versions = versionsRes.ok ? await versionsRes.json() : [];

// Check if current user is the owner (for settings link)
let isOwner = false;
if (sessionCookie) {
  try {
    const meRes = await fetch(`${apiBase}/api/accounts/me`, {
      headers: { Cookie: `session=${sessionCookie}` },
    });
    if (meRes.ok) {
      const me = await meRes.json();
      isOwner = me.slug === owner;
    }
  } catch {}
}
---

<Base title={`${data.name} — Underlay`} description={data.description}>
  <div class="max-w-3xl mx-auto px-4 py-10">
    <nav class="text-xs text-ink-muted mb-4">
      <a href={`/${owner}`} class="hover:text-ink">{owner}</a>
      <span class="mx-1">/</span>
      <span class="text-ink font-medium">{data.slug}</span>
    </nav>

    <div class="mb-6">
      <h1 class="text-xl font-semibold tracking-tight mb-1">{data.name}</h1>
      {data.description && <p class="text-sm text-ink-muted">{data.description}</p>}
      <div class="flex items-center gap-3 mt-2 text-xs text-ink-muted">
        <span class="border border-rule px-1.5 py-0.5">{data.public ? "public" : "private"}</span>
        <span>by <a href={`/${data.ownerSlug}`} class="text-link underline">{data.ownerName}</a></span>
        {isOwner && <a href={`/${owner}/${collection}/settings`} class="text-link underline">Settings</a>}
      </div>

      {versions.length > 0 && (
        <div class="flex items-center gap-2 mt-3">
          <div class="relative group">
            <button class="flex items-center gap-1 border border-rule px-3 py-1.5 text-xs font-medium hover:bg-parchment-dark transition-colors">
              Subscribe ▾
            </button>
            <div class="hidden group-hover:block absolute left-0 top-full mt-1 bg-parchment border border-rule shadow-sm z-10 min-w-[16rem]">
              <div class="p-3 border-b border-rule">
                <p class="text-xs font-medium mb-1">AT Protocol</p>
                <code class="block text-[11px] text-ink-muted break-all bg-parchment-dark px-2 py-1">{`at://did:web:underlay.org:${owner}/org.underlay.collection.${collection}`}</code>
                <p class="text-[10px] text-ink-muted mt-1">Follow in any AT Proto app</p>
              </div>
              <div class="p-3 border-b border-rule">
                <p class="text-xs font-medium mb-1">API</p>
                <code class="block text-[11px] text-ink-muted break-all bg-parchment-dark px-2 py-1">{`GET /api/collections/${owner}/${collection}/versions`}</code>
                <p class="text-[10px] text-ink-muted mt-1">Poll for new versions</p>
              </div>
              <a href={`/api/collections/${owner}/${collection}/export`} class="block p-3 text-xs font-medium hover:bg-parchment-dark transition-colors">
                Download .tar.gz
              </a>
            </div>
          </div>
        </div>
      )}
    </div>

    {data.latestVersion && (
      <div class="border border-rule p-4 mb-6 bg-parchment-dark">
        <div class="flex items-center justify-between mb-2">
          <span class="text-sm font-semibold">Latest: {data.latestVersion.semver} (#{data.latestVersion.number})</span>
          <a href={`/${owner}/${collection}/v/${data.latestVersion.number}`} class="text-xs text-link underline">View →</a>
        </div>
        <div class="grid grid-cols-3 gap-4 text-xs text-ink-muted">
          <div>
            <span class="block text-ink font-medium">{data.latestVersion.recordCount.toLocaleString()}</span>
            records
          </div>
          <div>
            <span class="block text-ink font-medium">{data.latestVersion.fileCount.toLocaleString()}</span>
            files
          </div>
          <div>
            <span class="block text-ink font-medium">{formatBytes(data.latestVersion.totalBytes)}</span>
            total
          </div>
        </div>
        {data.latestVersion.message && (
          <p class="text-xs text-ink-muted mt-2 italic">{data.latestVersion.message}</p>
        )}
      </div>
    )}

    <h2 class="text-sm font-semibold uppercase tracking-wide text-ink-muted mb-3">
      Version History ({versions.length})
    </h2>

    {versions.length === 0 ? (
      <p class="text-sm text-ink-muted">No versions yet.</p>
    ) : (
      <div class="space-y-1">
        {versions.map((v: any) => (
          <a href={`/${owner}/${collection}/v/${v.number}`} class="flex items-center justify-between border border-rule p-3 hover:bg-parchment-dark transition-colors text-sm">
            <div class="flex items-center gap-3">
              <span class="font-mono text-xs text-ink-muted">#{v.number}</span>
              <span class="font-medium">{v.semver}</span>
              {v.message && <span class="text-xs text-ink-muted truncate max-w-[20rem]">{v.message}</span>}
            </div>
            <div class="flex items-center gap-4 text-xs text-ink-muted">
              <span>{v.recordCount} records</span>
              <span>{new Date(v.createdAt).toLocaleDateString()}</span>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</Base>
