---
import Base from "@/layouts/Base.astro";
import SchemaBrowser from "@/components/SchemaBrowser";
---

<Base title="Schemas — Underlay" description="Browse globally deduplicated schemas across all public collections.">
  <div class="max-w-5xl mx-auto px-4 py-10">
    <h1 class="text-xl font-semibold tracking-tight font-sans mb-2">Schemas</h1>
    <p class="text-sm text-ink-muted mb-6">Browse content-addressed schemas shared across collections. Same shape = same hash = same schema.</p>

    <SchemaBrowser client:load />
  </div>
</Base>
