---
import Base from "@/layouts/Base.astro";
import { apiBase } from "@/lib/page-utils";

const q = Astro.url.searchParams.get("q") ?? "";
const slug = Astro.url.searchParams.get("slug") ?? "";
const page = parseInt(Astro.url.searchParams.get("page") ?? "1", 10);

const params = new URLSearchParams();
if (q) params.set("q", q);
if (slug) params.set("slug", slug);
params.set("page", String(page));

const schemasRes = await fetch(`${apiBase}/api/schemas?${params}`);
const result = schemasRes.ok ? await schemasRes.json() : { schemas: [], page: 1, pageSize: 50 };
const schemas: any[] = result.schemas ?? [];
const pageSize: number = result.pageSize ?? 50;

function buildPageUrl(p: number) {
  const u = new URLSearchParams();
  if (q) u.set("q", q);
  if (slug) u.set("slug", slug);
  u.set("page", String(p));
  return `/schemas?${u}`;
}
---

<Base title="Schemas — Underlay">
  <div class="max-w-5xl mx-auto px-4 py-8">
    <div class="mb-6">
      <h1 class="text-xl font-semibold tracking-tight mb-1">Published Schemas</h1>
      <p class="text-sm text-ink-muted">Record type schemas from public collections, browseable and reusable.</p>
    </div>

    <!-- Search -->
    <form method="get" action="/schemas" class="flex gap-2 mb-6">
      <input
        type="text"
        name="q"
        value={q}
        placeholder="Search by type name…"
        class="flex-1 border border-rule bg-parchment px-3 py-2 text-sm focus:outline-none focus:border-ink-muted"
      />
      <button type="submit" class="border border-rule px-4 py-2 text-sm hover:bg-parchment-dark transition-colors">
        Search
      </button>
      {(q || slug) && (
        <a href="/schemas" class="border border-rule px-4 py-2 text-sm hover:bg-parchment-dark transition-colors text-ink-muted">
          Clear
        </a>
      )}
    </form>

    {schemas.length === 0 ? (
      <p class="text-sm text-ink-muted py-8 text-center">No schemas found{q ? ` for "${q}"` : ""}.</p>
    ) : (
      <div class="border border-rule rounded overflow-hidden mb-6">
        {schemas.map((s: any, i: number) => {
          const fields = Object.keys((s.schema as any)?.properties ?? {});
          const path = `${s.ownerSlug}/${s.collectionSlug}@${s.semver}/${s.slug}`;
          return (
            <div class={`px-4 py-3 hover:bg-parchment-dark/50 transition-colors ${i < schemas.length - 1 ? "border-b border-rule" : ""}`}>
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0">
                  <div class="flex items-center gap-2 flex-wrap">
                    <a
                      href={`/${s.ownerSlug}/${s.collectionSlug}/schemas`}
                      class="font-medium text-sm text-link hover:underline"
                    >{s.slug}</a>
                    {s.sourceSchemaId && (
                      <span class="text-[11px] border border-rule px-1.5 py-0.5 text-ink-muted">adopted</span>
                    )}
                  </div>
                  <div class="flex items-center gap-2 mt-1">
                    <a
                      href={`/${s.ownerSlug}/${s.collectionSlug}/schemas`}
                      class="text-xs text-ink-muted hover:text-link hover:underline"
                    >{s.ownerSlug}/{s.collectionSlug}@{s.semver}</a>
                  </div>
                  {fields.length > 0 && (
                    <p class="text-xs text-ink-muted mt-1">{fields.join(", ")}</p>
                  )}
                  {s.usedBy && s.usedBy.length > 0 && (
                    <div class="mt-1">
                      <span class="text-[11px] text-ink-muted">Also used by: </span>
                      {s.usedBy.map((u: any, j: number) => (
                        <a
                          href={`/${u.ownerSlug}/${u.collectionSlug}/schemas`}
                          class="text-[11px] text-link hover:underline"
                        >{u.ownerSlug}/{u.collectionSlug}@{u.semver}{j < s.usedBy.length - 1 ? ", " : ""}</a>
                      ))}
                    </div>
                  )}
                </div>
                <div class="text-xs text-ink-muted shrink-0">{fields.length} field{fields.length !== 1 ? "s" : ""}</div>
              </div>
            </div>
          );
        })}
      </div>
    )}

    <!-- Pagination -->
    <div class="flex items-center justify-between text-xs text-ink-muted">
      <span>Page {page}</span>
      <div class="flex gap-2">
        {page > 1 && (
          <a href={buildPageUrl(page - 1)} class="border border-rule px-3 py-1.5 hover:bg-parchment-dark transition-colors">← Prev</a>
        )}
        {schemas.length === pageSize && (
          <a href={buildPageUrl(page + 1)} class="border border-rule px-3 py-1.5 hover:bg-parchment-dark transition-colors">Next →</a>
        )}
      </div>
    </div>
  </div>
</Base>
