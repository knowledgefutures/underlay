---
import Base from "@/layouts/Base.astro";

const apiBase = import.meta.env.DEV ? "http://localhost:3000" : `http://localhost:${import.meta.env.API_PORT ?? 3000}`;
const sessionCookie = Astro.cookies.get("session")?.value;

if (!sessionCookie) {
  return Astro.redirect("/login");
}

// Fetch current user
const meRes = await fetch(`${apiBase}/api/accounts/me`, {
  headers: { Cookie: `session=${sessionCookie}` },
});
if (!meRes.ok) {
  return Astro.redirect("/login");
}
const me = await meRes.json();

// Fetch user's corpora
const corporaRes = await fetch(`${apiBase}/api/accounts/${me.slug}/corpora`, {
  headers: { Cookie: `session=${sessionCookie}` },
});
const corpora = corporaRes.ok ? await corporaRes.json() : [];
---

<Base title="Dashboard — Underlay">
  <div class="max-w-3xl mx-auto px-4 py-10">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-xl font-semibold tracking-tight">Dashboard</h1>
      <a href="/settings" class="text-sm text-ink-muted hover:text-ink transition-colors">Settings</a>
    </div>

    <div class="flex items-center justify-between mb-4">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-ink-muted">
        Your Corpora ({corpora.length})
      </h2>
    </div>

    {corpora.length === 0 ? (
      <div class="border border-rule border-dashed p-6 text-center">
        <p class="text-sm text-ink-muted mb-2">No corpora yet.</p>
        <p class="text-xs text-ink-muted">Use the API to create and push your first corpus.</p>
      </div>
    ) : (
      <div class="space-y-2">
        {corpora.map((c: any) => (
          <a href={`/${me.slug}/${c.slug}`} class="flex items-center justify-between border border-rule p-3 hover:bg-parchment-dark transition-colors">
            <div>
              <span class="font-semibold text-sm">{me.slug}/{c.slug}</span>
              <p class="text-xs text-ink-muted mt-0.5">{c.description ?? c.name}</p>
            </div>
            <div class="flex items-center gap-3 text-xs text-ink-muted">
              <span class="border border-rule px-1.5 py-0.5">{c.public ? "public" : "private"}</span>
            </div>
          </a>
        ))}
      </div>
    )}

    <div class="mt-8 pt-6 border-t border-rule">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-ink-muted mb-3">Quick Reference</h2>
      <div class="text-xs text-ink-muted space-y-1">
        <p>Create a corpus: <code class="bg-parchment-dark px-1">POST /api/accounts/{me.slug}/corpora</code></p>
        <p>Push a version: <code class="bg-parchment-dark px-1">POST /api/corpora/{me.slug}/&lt;slug&gt;/versions</code></p>
        <p><a href="/docs/quickstart" class="text-link underline">Quickstart guide →</a></p>
      </div>
    </div>
  </div>
</Base>
