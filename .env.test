# Underlay
NODE_ENV=development
DATABASE_URL=postgresql://underlay:underlay@localhost:5432/underlay
SESSION_SECRET=dev-secret-change-me
APP_URL=http://localhost:4321
API_PORT=3000

# S3 (MinIO in dev)
